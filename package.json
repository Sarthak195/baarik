{
  "name": "baarik",
  "version": "0.1.0",
  "private": true,
  "description": "Baarik — understand any Indian contract before you sign it. Plain-language clause analysis with verified citations, a deterministic risk rubric, and routing to real Indian legal remedies.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "validate": "tsx scripts/validate-knowledge-base.ts",
    "check:size": "node scripts/check-file-size.mjs",
    "check:api": "node scripts/check-forbidden-apis.mjs",
    "check:repo": "node scripts/check-repo-size.mjs",
    "verify": "npm run typecheck && npm run lint && npm run validate && npm run test && npm run check:size && npm run check:api && npm run check:repo",
    "record:golden": "tsx scripts/record-golden.ts"
  },
  "dependencies": {
    "@google/genai": "2.22.0",
    "clsx": "2.1.1",
    "mammoth": "1.12.3",
    "next": "16.3.5",
    "pino": "10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "unpdf": "1.8.1",
    "yaml": "2.9.1",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.5",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
